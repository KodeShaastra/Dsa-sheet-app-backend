NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dsa_sheet
# Must be 32+ characters. The app refuses to start with this example value.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=dsa_token
